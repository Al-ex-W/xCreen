#!/usr/bin/env python3
"""Portable, state-free client of the running native xCreen application."""
import json
import os
from pathlib import Path
import socket
import stat
import struct
import subprocess
import sys
import time

HELP = '''usage: xcreen [--json] COMMAND
  status                         live app-owned state (never cached status.json)
  integrity [get|on|off]          off is explicit capture consent, subject to macOS gates
  session visibility [get|on|off]  show/hide the same Hermes session (default off)
  connection connect|disconnect|reconnect  (also accepted as top-level commands)
  models [list] | model select PROVIDER MODEL   (select also saves the xCreen default)
  model default [get] | model default PROVIDER MODEL  xCreen-session default only
  server [show]                   xCreen server URL, reachability and upload queue
  server set URL [--token-stdin | --token-file PATH]   token is stored in the Keychain
  flush                          upload everything still queued now
  settings [show] | settings set python|root|vault|timezone VALUE   (paths on the server)
  settings autodetect | autodetect   find Hermes and the vault on the server
  ask QUESTION [--wait-ms 0..30000]  explicit submission to the existing xCreen session
  history [--after CURSOR]        bounded sanitized history pages
  batches [--after BATCH_ID]      up to 20 durable batch metadata records
  batches retry                   verify, then re-queue only receipt-proven zero-effect batches
  verify                         read-only receipt reconciliation; no inference/note writes
  cancel
  images [list|open ID]           reply attachment metadata/open through the app
  panel [show|hide]
  start | stop | restart | quit
  logs [-n N] [--no-follow] [--gateway | --server]   (server logs only for a local server)
'''


def parse_command(args):
    if not args:
        raise ValueError(HELP)
    name, *rest = args
    if name == 'session' and rest and rest[0] == 'visibility':
        if rest[1:] in ([], ['get']):
            return {'command': 'visibility'}
        if rest[1:] in (['on'], ['off']):
            return {'command': 'visibility', 'value': rest[1]}
    if name == 'connection' and len(rest) == 1:
        name, rest = rest[0], []
    if name in ('status', 'connect', 'disconnect', 'reconnect', 'cancel', 'history', 'verify', 'quit', 'autodetect', 'flush') and not rest:
        return {'command': name}
    if name == 'batches' and rest == ['retry']:
        return {'command': 'retrybatches'}
    if name in ('history', 'batches'):
        if not rest:
            return {'command': name}
        if len(rest) == 2 and rest[0] == '--after' and 0 < len(rest[1].encode()) <= 4096:
            return {'command': name, 'value': rest[1]}
    if name == 'integrity' and (not rest or rest == ['get']):
        return {'command': name}
    if name == 'integrity' and rest in (['on'], ['off']):
        return {'command': name, 'value': rest[0]}
    if name == 'models' and rest in ([], ['list']):
        return {'command': name}
    if name == 'model' and rest in (['default'], ['default', 'get']):
        return {'command': 'modeldefault'}
    if name == 'model' and len(rest) == 3 and rest[0] == 'default':
        return {'command': 'modeldefault', 'provider': rest[1], 'model': rest[2]}
    if name == 'model' and len(rest) == 3 and rest[0] == 'select':
        return {'command': name, 'provider': rest[1], 'model': rest[2]}
    if name == 'settings':
        if rest in ([], ['show']):
            return {'command': name}
        if rest == ['autodetect']:
            return {'command': 'autodetect'}
        if len(rest) == 3 and rest[0] == 'set' and rest[1] in ('python', 'root', 'vault', 'timezone'):
            return {'command': name, 'value': rest[1] + '=' + rest[2]}
    if name == 'server':
        if rest in ([], ['show']):
            return {'command': 'server'}
        if len(rest) in (2, 3, 4) and rest[0] == 'set':
            request = {'command': 'server', 'value': rest[1]}
            if rest[2:] == ['--token-stdin']:
                request['token'] = sys.stdin.readline().strip()
            elif len(rest) == 4 and rest[2] == '--token-file':
                request['token'] = Path(rest[3]).expanduser().read_text().strip()
            elif rest[2:]:
                raise ValueError('invalid command or arguments\n' + HELP)
            return request
    if name == 'panel' and rest in ([], ['show'], ['hide']):
        return {'command': name, 'value': rest[0] if rest else 'show'}
    if name == 'images':
        if rest in ([], ['list']):
            return {'command': name}
        if len(rest) == 2 and rest[0] == 'open':
            return {'command': name, 'value': rest[1]}
    if name == 'ask':
        wait = 0
        if len(rest) == 3 and rest[1] == '--wait-ms':
            wait = int(rest[2]); rest = rest[:1]
        if len(rest) == 1 and rest[0].strip() and len(rest[0].encode()) <= 32000 and 0 <= wait <= 30000:
            return {'command': name, 'question': rest[0], 'wait_ms': wait}
    raise ValueError('invalid command or arguments\n' + HELP)


def _load_getpeereid():
    try:
        import ctypes, ctypes.util
        libc = ctypes.CDLL(ctypes.util.find_library('c') or '/usr/lib/libSystem.B.dylib', use_errno=True)
        fn = libc.getpeereid
        fn.argtypes = [ctypes.c_int, ctypes.POINTER(ctypes.c_uint32), ctypes.POINTER(ctypes.c_uint32)]
        fn.restype = ctypes.c_int
        return fn
    except (OSError, AttributeError, ImportError):
        return None

_getpeereid = _load_getpeereid()
# Fallback only: <sys/un.h> SOL_LOCAL=0, LOCAL_PEERCRED=1; struct xucred is
# (u_int cr_version, uid_t cr_uid, short cr_ngroups, gid_t cr_groups[16]) = 76 bytes, uid at offset 4.
_SOL_LOCAL, _LOCAL_PEERCRED, _XUCRED_SIZE, _XUCRED_VERSION = 0, 1, 76, 0


def peer_uid(sock):
    if _getpeereid is not None:
        import ctypes
        uid, gid = ctypes.c_uint32(), ctypes.c_uint32()
        if _getpeereid(sock.fileno(), ctypes.byref(uid), ctypes.byref(gid)) != 0:
            raise ValueError('cannot read control server credentials')
        return uid.value
    cred = sock.getsockopt(_SOL_LOCAL, _LOCAL_PEERCRED, _XUCRED_SIZE)
    if len(cred) < 8 or struct.unpack_from('I', cred, 0)[0] != _XUCRED_VERSION:
        raise ValueError('cannot read control server credentials')
    return struct.unpack_from('I', cred, 4)[0]


def request(command, directory=None):
    directory = Path(directory or Path.home() / '.xcreen-control')
    endpoint = directory / 'control.sock'
    for path, kind, mode in ((directory, stat.S_ISDIR, 0o700), (endpoint, stat.S_ISSOCK, 0o600)):
        info = path.lstat()
        if not kind(info.st_mode) or info.st_uid != os.getuid() or stat.S_IMODE(info.st_mode) != mode:
            raise ValueError('unsafe local control endpoint')
    data = json.dumps(command).encode() + b'\n'
    if len(data) > 65536:
        raise ValueError('request too large')
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as client:
        client.settimeout(38)
        client.connect(str(endpoint))
        if peer_uid(client) != os.getuid():
            raise ValueError('control server belongs to a different user')
        client.sendall(data)
        response = bytearray(); deadline = time.monotonic() + 38
        while b'\n' not in response:
            client.settimeout(max(0.001, deadline - time.monotonic()))
            chunk = client.recv(8192)
            if not chunk:
                raise ValueError('app closed the control connection')
            response.extend(chunk)
            if len(response) > 1048576:
                raise ValueError('response too large')
        result = json.loads(response.split(b'\n', 1)[0])
        if not result.get('ok'):
            raise ValueError(result.get('error', 'command failed'))
        return result


def main(args=None):
    args = list(sys.argv[1:] if args is None else args)
    # Global options precede the command; positional values remain literal.
    as_json = bool(args and args[0] == '--json')
    if as_json:
        args.pop(0)
    if not args or args[0] in ('help', '-h', '--help'):
        print(HELP); return 0
    app = Path.home() / 'Applications/xCreen.app'
    if args == ['start']:
        subprocess.run(['/usr/bin/open', str(app)], check=True); return 0
    if args == ['restart']:
        request({'command': 'quit'})
        deadline = time.monotonic() + 5
        while (Path.home() / '.xcreen-control/control.sock').exists() and time.monotonic() < deadline:
            time.sleep(0.05)
        if (Path.home() / '.xcreen-control/control.sock').exists():
            raise ValueError('app did not stop')
        subprocess.run(['/usr/bin/open', str(app)], check=True); return 0
    if args == ['stop']:
        args = ['quit']
    if args[0] == 'logs':
        n, follow, name = 40, True, 'xcreen.log'
        rest = args[1:]
        while rest:
            arg = rest.pop(0)
            if arg == '--no-follow': follow = False
            elif arg == '--gateway': name = 'gateway.log'
            elif arg == '--server': name = 'server.log'
            elif arg == '-n' and rest: n = int(rest.pop(0))
            else: raise ValueError('invalid logs arguments')
        if not 1 <= n <= 10000: raise ValueError('invalid log count')
        file = Path.home() / 'Library/Logs/xCreen' / name
        return subprocess.call(['/usr/bin/tail', '-n', str(n)] + (['-F'] if follow else []) + [str(file)])
    result = request(parse_command(args))
    print(json.dumps(result if as_json else result.get('reply') or result.get('snapshot') or result, indent=2, ensure_ascii=False))
    return 0


if __name__ == '__main__':
    try:
        sys.exit(main())
    except (OSError, ValueError, subprocess.CalledProcessError) as error:
        print('xcreen: ' + str(error), file=sys.stderr)
        sys.exit(1)
